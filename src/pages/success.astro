---
import MainLayout from '../layouts/main.astro';
import { CheckCircle, ArrowRight, Sparkles } from 'lucide-react';
---

<MainLayout pageClass="">
  <div class="min-h-screen bg-gradient-to-br from-obsidian via-steel to-obsidian flex items-center justify-center p-4">
    <div class="max-w-2xl w-full bg-chalk rounded-2xl shadow-2xl p-8 md:p-12 text-center border-2 border-signal">
      <!-- Success Icon -->
      <div class="w-20 h-20 bg-gradient-to-br from-signal to-amber rounded-full flex items-center justify-center mx-auto mb-6 shadow-lg animate-bounce">
        <CheckCircle size={48} class="text-obsidian" />
      </div>

      <!-- Success Message -->
      <h1 class="text-3xl md:text-4xl font-bold text-obsidian mb-4 font-heading">
        🎉 Welcome to Boundless!
      </h1>
      
      <p class="text-lg md:text-xl text-steel mb-6 font-body">
        Your payment was successful! We're excited to help you grow your painting business.
      </p>

      <!-- What's Next Section -->
      <div class="bg-obsidian/5 rounded-xl p-6 mb-8 text-left border border-obsidian/10">
        <h2 class="text-xl font-bold text-obsidian mb-4 font-heading flex items-center gap-2">
          <Sparkles size={24} class="text-signal" />
          What Happens Next?
        </h2>
        
        <div class="space-y-3">
          <div class="flex items-start gap-3">
            <div class="w-6 h-6 rounded-full bg-signal/20 flex items-center justify-center flex-shrink-0 mt-0.5">
              <span class="text-signal font-bold text-sm">1</span>
            </div>
            <p class="text-obsidian/80 text-sm md:text-base">
              <strong class="text-obsidian">Check your email</strong> - You'll receive a confirmation with your receipt and next steps
            </p>
          </div>
          
          <div class="flex items-start gap-3">
            <div class="w-6 h-6 rounded-full bg-signal/20 flex items-center justify-center flex-shrink-0 mt-0.5">
              <span class="text-signal font-bold text-sm">2</span>
            </div>
            <p class="text-obsidian/80 text-sm md:text-base">
              <strong class="text-obsidian">Schedule your onboarding call</strong> - We'll reach out within 24 hours to get you started
            </p>
          </div>
          
          <div class="flex items-start gap-3">
            <div class="w-6 h-6 rounded-full bg-signal/20 flex items-center justify-center flex-shrink-0 mt-0.5">
              <span class="text-signal font-bold text-sm">3</span>
            </div>
            <p class="text-obsidian/80 text-sm md:text-base">
              <strong class="text-obsidian">Get your system built</strong> - We'll set up everything and train your team
            </p>
          </div>
        </div>
      </div>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 bg-signal hover:bg-amber text-obsidian font-bold py-3 px-6 rounded-lg transition-all duration-300 shadow-lg hover:shadow-xl font-heading"
        >
          Back to Home
          <ArrowRight size={20} />
        </a>
        
        <a
          href="https://calendly.com/jason-boundlesscorp/30min"
          class="inline-flex items-center justify-center gap-2 bg-obsidian hover:bg-obsidian/90 text-chalk font-bold py-3 px-6 rounded-lg transition-all duration-300 shadow-lg hover:shadow-xl font-heading border-2 border-obsidian"
        >
          Schedule Onboarding Call
        </a>
      </div>

      <!-- Support Info -->
      <div class="mt-8 pt-6 border-t border-obsidian/10">
        <p class="text-sm text-steel font-body">
          Questions? Email us at <a href="mailto:support@boundless.com" class="text-signal hover:text-amber font-semibold">support@boundless.com</a>
          <br />or call <a href="tel:+17782009960" class="text-signal hover:text-amber font-semibold">+1 (778) 200-9960</a>
        </p>
      </div>
    </div>
  </div>
</MainLayout>

<script>
  // Trigger confetti on page load
  import confetti from 'canvas-confetti';
  
  confetti({
    particleCount: 100,
    spread: 70,
    origin: { y: 0.6 },
    colors: ['#a28b6d', '#c4935a', '#f5ede0', '#35271c'],
  });

  // Track conversion in analytics
  if (typeof window !== 'undefined' && (window as any).gtag) {
    (window as any).gtag('event', 'purchase', {
      event_category: 'Ecommerce',
      event_label: 'Package Purchase',
    });
  }
</script>
