{
  "name": "@boundless/gmail-notion-sync",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "d1:init:local": "wrangler d1 execute boundless-gmail-notion-sync --local --file=schema.sql --config wrangler.jsonc",
    "d1:init:remote": "wrangler d1 execute boundless-gmail-notion-sync --remote --file=schema.sql --config wrangler.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250726.0",
    "typescript": "^5.9.3",
    "wrangler": "4.26.1"
  }
}
