{
  "name": "@boundless/gmail-notion-sync",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc",
    "deploy": "node -e \"console.error('Production deploy is intentionally disabled on V0.1. Use npm run deploy:staging.'); process.exit(1)\"",
    "typecheck": "tsc --noEmit",
    "d1:init:local": "wrangler d1 execute boundless-gmail-notion-sync --local --file=schema.sql --config wrangler.jsonc",
    "d1:init:remote": "wrangler d1 execute boundless-gmail-notion-sync --remote --file=schema.sql --config wrangler.jsonc",
    "test": "vitest run",
    "test:watch": "vitest",
    "preflight": "node scripts/preflight.mjs",
    "preflight:staging": "BOUNDLESS_WRANGLER_CONFIG=wrangler.staging.jsonc node scripts/preflight.mjs",
    "deploy:staging": "npm run preflight:staging && wrangler deploy --config wrangler.staging.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261011.1",
    "typescript": "7.0.2",
    "wrangler": "4.149.0",
    "vitest": "5.0.3"
  }
}
